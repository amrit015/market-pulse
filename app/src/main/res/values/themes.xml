<resources>
    <!-- Base application theme. -->
    <style name="Theme.MarketPulse" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- No android:statusBarColor here on purpose. This was a static opaque color left over
             from the original template theme, and it was fighting enableEdgeToEdge()'s attempt to
             make the status bar transparent. The app's actual status bar appearance is owned by
             MainActivity.onCreate() (enableEdgeToEdge()) and MarketPulseTheme.kt (icon contrast per
             preset) now, not this XML theme. -->
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.MarketPulse.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MarketPulse.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MarketPulse.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>