            android:pathData="M 54,26 A 28,28 0 1 1 54,82 A 28,28 0 1 1 54,26 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#514E6B" />

        <!-- Innermost concentric lighter purple ring (Tighter Radius: 21) -->
        <path
            android:pathData="M 54,33 A 21,21 0 1 1 54,75 A 21,21 0 1 1 54,33 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#BFAEE3" />

        <!-- Bar Chart (Preserving the 5dp spacing from the previous step) -->

        <!-- Red tall bar (right) -->
        <path
            android:fillColor="#F08E8F"
            android:pathData="M 68.5,35 H 75.5 A 3,3 0 0 1 78.5,38 V 73 A 3,3 0 0 1 75.5,76 H 68.5 A 3,3 0 0 1 65.5,73 V 38 A 3,3 0 0 1 68.5,35 Z" />

