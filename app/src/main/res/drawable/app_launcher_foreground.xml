        <!-- Green short bar (left) -->
        <path
            android:fillColor="#92C17D"
            android:pathData="M 32.5,55 H 39.5 A 3,3 0 0 1 42.5,58 V 73 A 3,3 0 0 1 39.5,76 H 32.5 A 3,3 0 0 1 29.5,73 V 58 A 3,3 0 0 1 32.5,55 Z" />
    </group>
</vector>