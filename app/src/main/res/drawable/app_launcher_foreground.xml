        android:name="scaled_mark"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.65"
        android:scaleY="0.65">

        <!-- Outermost concentric dark purple-grey rings (Tighter Radii: 42, 35, 28) -->
        <path
            android:pathData="M 54,12 A 42,42 0 1 1 54,96 A 42,42 0 1 1 54,12 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#514E6B" />
        <path
            android:pathData="M 54,19 A 35,35 0 1 1 54,89 A 35,35 0 1 1 54,19 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#514E6B" />
