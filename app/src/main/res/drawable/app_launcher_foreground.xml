<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shrinks the whole mark toward the viewport center so it sits inside the adaptive
     icon safe zone with visible background margin, instead of nearly filling the
     108x108 canvas edge-to-edge. -->
