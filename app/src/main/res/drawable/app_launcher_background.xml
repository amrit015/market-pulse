<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon background: diagonal warm sand gradient, pale sand top-left to
     a deeper tan bottom-right, chosen as a neutral warm backdrop that doesn't compete with
     the foreground mark's own green/red/blue accents while still keeping contrast against
     its dark strokes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#2D3344" />
                <item android:offset="1" android:color="#121D2E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
