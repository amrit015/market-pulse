<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon's own 3-bar mark, recropped to fill this canvas. app_launcher_monochrome's
     coordinates leave the mark small in the middle of a 108x108 box, sized for the extra inset an
     adaptive launcher icon's own mask applies on top; a notification icon gets no such second
     inset, so reusing that box verbatim left the glyph looking tiny with empty space around it at
     status-bar size. The viewport here is cropped tight to the mark's own bounding box (padded a
     few units) instead, so the bars fill almost the whole 24dp icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="56"
    android:viewportHeight="56">

    <!-- Tall bar (right) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 42.5,7.5 H 49.5 A 3,3 0 0 1 52.5,10.5 V 45.5 A 3,3 0 0 1 49.5,48.5 H 42.5 A 3,3 0 0 1 39.5,45.5 V 10.5 A 3,3 0 0 1 42.5,7.5 Z" />

    <!-- Medium bar (center) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 24.5,17.5 H 31.5 A 3,3 0 0 1 34.5,20.5 V 45.5 A 3,3 0 0 1 31.5,48.5 H 24.5 A 3,3 0 0 1 21.5,45.5 V 20.5 A 3,3 0 0 1 24.5,17.5 Z" />

    <!-- Short bar (left) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 6.5,27.5 H 13.5 A 3,3 0 0 1 16.5,30.5 V 45.5 A 3,3 0 0 1 13.5,48.5 H 6.5 A 3,3 0 0 1 3.5,45.5 V 30.5 A 3,3 0 0 1 6.5,27.5 Z" />
</vector>
